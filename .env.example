# Copia questo file in `.env` (escluso da git) e valorizza le chiavi.
# In produzione la stessa interfaccia (src/marketmind_ai/config.py) potrà
# leggere da podman secret senza cambiare il chiamante.

# --- API dati ---
FINNHUB_API_KEY=
FRED_API_KEY=
FMP_API_KEY=

# --- LLM ---
GEMINI_API_KEY=

# --- Database (PostgreSQL + TimescaleDB) ---
# In sviluppo locale questi valori devono combaciare con
# deploy/quadlet/marketmind-db.container.
POSTGRES_HOST=127.0.0.1
# "localhost" risolve anche su ::1 (IPv6): il container pubblica solo su
# IPv4, quindi con "localhost" il tentativo IPv6 resta appeso fino al
# timeout prima di arrivare a quello IPv4 che funziona davvero — usa
# sempre l'IP esplicito qui.
POSTGRES_PORT=5432
POSTGRES_DB=marketmind
POSTGRES_USER=marketmind
POSTGRES_PASSWORD=marketmind
# Se impostata, ha precedenza su tutte le POSTGRES_* sopra.
# DATABASE_URL=postgresql+psycopg://marketmind:marketmind@localhost:5432/marketmind
